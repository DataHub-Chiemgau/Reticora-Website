# Apache-Testkonfiguration; Platzhalter @...@ ersetzt start.sh.
ServerName localhost
ServerRoot "@TMP@"
PidFile "@TMP@/apache.pid"
Mutex file:@TMP@ default
DefaultRuntimeDir "@TMP@"
Listen 127.0.0.1:8080
ServerTokens Prod
# Firefox blieb in der CI bei etwa jedem hundertsten Seitenaufruf bis zum Zeitlimit
# im Laden hängen. Ohne wiederverwendete Verbindungen entfällt das Rennen zwischen
# dem Schließen einer Keep-Alive-Verbindung durch den Server und ihrer Wiederverwendung.
KeepAlive Off

LoadModule mpm_event_module @MODS@/mod_mpm_event.so
LoadModule authz_core_module @MODS@/mod_authz_core.so
LoadModule dir_module @MODS@/mod_dir.so
LoadModule mime_module @MODS@/mod_mime.so
LoadModule rewrite_module @MODS@/mod_rewrite.so
LoadModule headers_module @MODS@/mod_headers.so
LoadModule expires_module @MODS@/mod_expires.so
LoadModule deflate_module @MODS@/mod_deflate.so
LoadModule setenvif_module @MODS@/mod_setenvif.so
LoadModule filter_module @MODS@/mod_filter.so
<IfModule !mod_log_config.c>
  LoadModule log_config_module @MODS@/mod_log_config.so
</IfModule>
LoadModule alias_module @MODS@/mod_alias.so
# PHP wie beim Hoster über FastCGI (PHP-FPM); lead.php liegt in einer Webroot-Kopie unter api/ (siehe unten)
LoadModule proxy_module @MODS@/mod_proxy.so
LoadModule proxy_fcgi_module @MODS@/mod_proxy_fcgi.so
LoadModule env_module @MODS@/mod_env.so
@IDENTITY@
TypesConfig /etc/mime.types
AddType font/woff2 .woff2
AddDefaultCharset UTF-8

ErrorLog "|/bin/sh -c 'exec cat >&2'"
# Zugriffsprotokoll als Beleg für das Hängen von Firefox beim Laden (Ursache ungeklärt): Antwortzeit in µs (%D) und
# Verbindungsstatus (%X: X abgebrochen, + bleibt offen, - wird geschlossen). start.sh kopiert die Datei beim Beenden
# nach $RETICORA_ACCESS_LOG, wenn gesetzt (die CI lädt sie bei einem Fehlschlag hoch).
LogFormat "%h %t \"%r\" %>s %b %D %X" reticora_access
CustomLog "@TMP@/access.log" reticora_access
LogLevel warn

DocumentRoot "@DOCROOT@"
<Directory />
  AllowOverride None
  Require all denied
</Directory>
<Directory "@DOCROOT@">
  AllowOverride All
  Options FollowSymLinks
  Require all granted
</Directory>
# /api/ wie im Paket (www/api/lead.php und www/api/.htaccess aus backend/public), Sicherheitsprüfung S-07: Die Webroot-Kopie
# @TMP@/www trägt dieselbe Wurzel-.htaccess wie dist/; Kopfzeilen, Sperren und LimitRequestBody wirken also wie beim Hoster.
# Konfiguration und Backend-Pfad gehen als FastCGI-Parameter (SetEnv) an PHP, lead.php liest sie mit getenv().
Alias "/api/" "@TMP@/www/api/"
<Directory "@TMP@/www">
  AllowOverride All
  Options FollowSymLinks
  Require all granted
  <FilesMatch "\.php$">
    SetHandler "proxy:fcgi://@FPM@"
  </FilesMatch>
</Directory>
<Directory "@TMP@/www/api">
  SetEnv RETICORA_HOME "@BACKEND@"
  SetEnv RETICORA_CONFIG "@CONFIG_MAIN@"
</Directory>
# api-limit-anfang: zweite Instanz mit Standard-Limit, nur für den Test des Rate-Limits
Alias "/api-limit/" "@TMP@/www/api-limit/"
<Directory "@TMP@/www/api-limit">
  SetEnv RETICORA_HOME "@BACKEND@"
  SetEnv RETICORA_CONFIG "@CONFIG_LIMIT@"
</Directory>
# api-limit-ende
DirectoryIndex index.html
