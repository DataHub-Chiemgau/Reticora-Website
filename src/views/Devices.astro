---
import Leitstand from '../layouts/Leitstand.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import Cta from '../components/Cta.astro';
import ActionRow from '../components/ActionRow.astro';
import Button from '../components/Button.astro';
import Beleg from '../components/Beleg.astro';
import Rich from '../components/Rich.astro';
import Para from '../components/Para.astro';
import { DEVICES } from '../data/devices';
import type { Lang } from '../data/types';
import { content } from '../content';
import { nbsp } from '../content/rich';
import { ui } from '../i18n';
import { localize } from '../i18n/routes';

/** Seite „Geräte“: Tabelle aus DEVICES, nach Kategorie gegliedert; der Filter ist eine Verbesserung mit JavaScript. */
interface Props { lang: Lang }
const { lang } = Astro.props;
const C = content(lang).geraete;
const UI = ui(lang);
const F = C.familien;

const cats = Object.keys(F.categories) as (keyof typeof F.categories)[];
const unknown = DEVICES.filter((d) => !cats.includes(d.category as (typeof cats)[number]));
if (unknown.length) throw new Error(`Geräte ohne Kategorie in der Seite: ${unknown.map((d) => `${d.vendor} ${d.family}`).join(', ')}`);
const groups = cats
  .map((cat) => ({ cat, label: F.categories[cat], rows: DEVICES.filter((d) => d.category === cat) }))
  .filter((g) => g.rows.length > 0);
const count = (n: number) => (n === 1 ? UI.devices.one : UI.devices.many.replace('{n}', String(n)));
---

<Leitstand title={C.meta.title} description={C.meta.description} lang={lang} path={localize('/geraete/', lang)}>
  <PageHero title={nbsp(C.hero.title)}>
    <Fragment slot="lead"><Rich text={C.hero.lead} lang={lang} /></Fragment>
    <div class="page-actions"><ActionRow actions={C.hero.actions} lang={lang} /></div>
  </PageHero>

  <Section id={F.id} title={F.title}>
    <div class="home-stack">
      <div class="dev-filter-root" data-filter data-one={UI.devices.one} data-many={UI.devices.many}>
        <div class="dev-filter" role="group" aria-label={UI.devices.filter} hidden>
          <button type="button" class="rt-btn rt-btn--secondary dev-chip" data-set="all" aria-pressed="true">{UI.devices.all}</button>
          {groups.map((g) => <button type="button" class="rt-btn rt-btn--secondary dev-chip" data-set={g.cat} aria-pressed="false">{g.label}</button>)}
        </div>
        <p class="dev-count" aria-live="polite">{count(DEVICES.length)}</p>
        <Beleg claim={F.claim} lang={lang} />
      </div>
      <nav class="dev-jump" aria-label={F.jump}>
        <ul>
          {groups.map((g) => <li><a href={`#${F.groupId}-${g.cat}`}>{g.label}<span class="dev-jump-n"> ({g.rows.length})</span></a></li>)}
        </ul>
      </nav>
      <div class="dev-table">
        <p class="rt-table-hint">{UI.tableHint}</p>
        <section class="rt-table-wrap" tabindex="0" aria-label={F.tableLabel}>
          <table class="rt-table">
            <thead>
              <tr>
                <th scope="col">{F.heads.vendor}</th>
                <th scope="col">{F.heads.family}</th>
                <th scope="col">{F.heads.protocols}</th>
              </tr>
            </thead>
            {groups.map((g) => (
              <tbody data-cat={g.cat} data-n={g.rows.length} id={`${F.groupId}-${g.cat}`}>
                <tr class="dev-group"><th scope="rowgroup" colspan="3">{g.label}</th></tr>
                {g.rows.map((d) => (
                  <tr>
                    <th scope="row">{d.vendor}</th>
                    <td>{d.family}</td>
                    <td>{d.protocols.join(', ')}</td>
                  </tr>
                ))}
              </tbody>
            ))}
          </table>
        </section>
        <p class="home-caption">{F.note}</p>
      </div>
    </div>
  </Section>

  <Section id={C.erkennung.id} title={C.erkennung.title}>
    <div class="home-stack">
      <div class="home-block"><Para text={C.erkennung.text} lang={lang} /></div>
      <Button class="home-link" variant="secondary" href={localize(C.erkennung.link.href, lang)}>{C.erkennung.link.label}</Button>
    </div>
  </Section>

  <Section id={C.unbekannt.id} title={C.unbekannt.title}>
    <div class="home-block"><Para text={C.unbekannt.text} lang={lang} /></div>
  </Section>

  <Section id={C.profile.id} title={C.profile.title}>
    <div class="home-stack">
      <div class="home-block"><Para text={C.profile.text} lang={lang} /></div>
      <Button class="home-link" variant="secondary" href={localize(C.profile.link.href, lang)}>{C.profile.link.label}</Button>
    </div>
  </Section>

  <Cta lang={lang} />
</Leitstand>

<script>
  import '../islands/filter';
</script>
