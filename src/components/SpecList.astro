---
import Beleg from './Beleg.astro';
import type { ClaimId, Lang } from '../data/types';

interface Props { items: { term: string; value: string; claim?: ClaimId }[]; lang: Lang }
const { items, lang } = Astro.props;
---

<dl class="rt-spec">
  {items.map((i) => <div><dt>{i.term}</dt><dd>{i.value}{i.claim && <>{' '}<Beleg claim={i.claim} lang={lang} /></>}</dd></div>)}
</dl>
