---
interface Props { id: string; title: string; lead?: string }
const { id, title, lead } = Astro.props;
---

<section class="rt-section" id={id} aria-labelledby={`${id}-titel`}>
  <div class="rt-container">
    <div class="rt-section-head">
      <h2 class="heading-l" id={`${id}-titel`}>{title}</h2>
      {lead && <p class="lead">{lead}</p>}
    </div>
    <slot />
  </div>
</section>
