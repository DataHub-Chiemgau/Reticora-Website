---
interface Props { eyebrow?: string; title: string; lead: string }
const { eyebrow, title, lead } = Astro.props;
---

<section class="rt-section page-hero" aria-labelledby="seite-titel">
  <div class="rt-container">
    {eyebrow && <p class="data-label page-hero-eyebrow">{eyebrow}</p>}
    <h1 class="display-xl" id="seite-titel">{title}</h1>
    <p class="lead">{lead}</p>
  </div>
</section>
