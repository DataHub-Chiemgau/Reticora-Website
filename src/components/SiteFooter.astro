---
import { LINKS } from '../data/links';
import { SITE } from '../data/site';
import type { Lang } from '../data/types';
import { UI } from '../i18n/de';

interface Props { lang: Lang }
const { lang } = Astro.props;
const f = UI.footer;
const other = lang === 'de' ? { href: UI.lang.enHref, code: 'en' } : { href: UI.lang.deHref, code: 'de' };
---

<footer class="rt-footer">
  <div class="rt-footer-cols">
    {f.columns.map((c) => (
      <div><h2>{c.title}</h2>{c.links.map((l) => <a href={l.href}>{l.label}</a>)}</div>
    ))}
    <div>
      <h2>{f.contactTitle}</h2>
      <a href={f.contactHref}>{UI.actions.contact}</a>
      <a href={f.demoHref}>{UI.actions.demo}</a>
      <a href={LINKS.login}>{UI.actions.login}</a>
    </div>
  </div>
  <div class="rt-footer-legal">
    <span>{SITE.company}</span>
    {f.legal.map((l) => <a href={l.href}>{l.label}</a>)}
    <span>{UI.b2b.replace(/\.$/, '')}</span>
    <a href={other.href} lang={other.code} hreflang={other.code}>{lang === 'de' ? f.english : 'Deutsch'}</a>
  </div>
</footer>
