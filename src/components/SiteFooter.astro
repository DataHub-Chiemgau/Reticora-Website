---
import { LINKS } from '../data/links';
import { SITE } from '../data/site';
import type { Lang } from '../data/types';
import { ui } from '../i18n';
import { counterpart, isBuilt, localize } from '../i18n/routes';

interface Props { lang: Lang; path: string }
const { lang, path } = Astro.props;
const T = ui(lang);
const f = T.footer;
const other = counterpart(path);
const otherLang: Lang = lang === 'de' ? 'en' : 'de';
const live = other !== null && isBuilt(other);
const L = (href: string) => localize(href, lang);
---

<footer class="rt-footer">
  <div class="rt-container rt-footer-inner">
  <div class="rt-footer-cols">
    {f.columns.map((c) => (
      <div><h2>{c.title}</h2>{c.links.map((l) => <a href={L(l.href)}>{l.label}</a>)}</div>
    ))}
    <div>
      <h2>{f.contactTitle}</h2>
      <a href={L(f.contactHref)}>{T.actions.contact}</a>
      <a href={L(f.demoHref)}>{T.actions.demo}</a>
      <a href={LINKS.login}>{T.actions.login}</a>
    </div>
  </div>
  <div class="rt-footer-legal">
    <span>{SITE.company}</span>
    {f.legal.map((l) => <a href={L(l.href)}>{l.label}</a>)}
    <span>{T.b2bShort}</span>
    {live
      ? <a href={other} lang={otherLang} hreflang={otherLang}>{f.switch}</a>
      : other !== null && <span class="is-off" lang={otherLang} title={T.lang.soon}>{f.switchSoon}</span>}
  </div>
  </div>
</footer>
