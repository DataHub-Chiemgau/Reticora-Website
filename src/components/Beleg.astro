---
import { belegText } from './beleg-text';
import type { ClaimId, Lang } from '../data/types';
import { ui } from '../i18n';

interface Props { claim: ClaimId; lang: Lang }
const { claim: id, lang } = Astro.props;
const c = belegText(id, lang);
const T = ui(lang);
---

<details class="rt-beleg" data-claim={id}><summary>{T.beleg}<span class="sr-only">: {c.title}</span></summary><div class="rt-beleg-body"><b>{c.title}</b><br />{c.evidence}</div></details>
