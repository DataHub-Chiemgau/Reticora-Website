---
import Beleg from './Beleg.astro';
import type { ClaimId, Lang } from '../data/types';

interface Props { items: { label: string; value: string; claim?: ClaimId }[]; lang?: Lang }
const { items, lang = 'de' } = Astro.props;
---

<dl class="rt-strip">
  {items.map((i) => <div><dt>{i.label}</dt><dd>{i.value}{i.claim && <>{' '}<Beleg claim={i.claim} lang={lang} /></>}</dd></div>)}
</dl>
