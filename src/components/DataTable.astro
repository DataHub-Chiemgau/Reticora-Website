---
interface Props {
  label: string;
  columns: { key: string; head: string; numeric?: boolean }[];
  rows: Record<string, string>[];
  rowHeader: string;
}
const { label, columns, rows, rowHeader } = Astro.props;
---

<div class="rt-table-wrap" tabindex="0" role="region" aria-label={label}>
  <table class="rt-table">
    <thead>
      <tr>{columns.map((c) => <th scope="col" class={c.numeric ? 'num' : undefined}>{c.head}</th>)}</tr>
    </thead>
    <tbody>
      {rows.map((r) => (
        <tr>
          {columns.map((c) => c.key === rowHeader
            ? <th scope="row">{r[c.key]}</th>
            : <td class={c.numeric ? 'num' : undefined}>{r[c.key]}</td>)}
        </tr>
      ))}
    </tbody>
  </table>
</div>
