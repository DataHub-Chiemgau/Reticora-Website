---
import BrandMark from './BrandMark.astro';
import Button from './Button.astro';
import LangSwitch from './LangSwitch.astro';
import { LINKS } from '../data/links';
import type { Lang } from '../data/types';
import { ui } from '../i18n';
import { dePath, localize } from '../i18n/routes';

interface Props { lang: Lang; path: string }
const { lang, path } = Astro.props;
const T = ui(lang);
const home = localize('/', lang);
const here = dePath(path);
const items = T.nav.items.map((i) => ({ label: i.label, href: localize(i.href, lang), current: here.startsWith(i.match) }));
const demo = localize(T.footer.demoHref, lang);
---

<header class="rt-site-header">
  <div class="rt-header">
    <a class="rt-brand" href={home}><BrandMark />Reticora</a>
    <nav class="rt-nav" aria-label={T.nav.label}>
      {items.map((i) => <a href={i.href} aria-current={i.current ? 'page' : undefined}>{i.label}</a>)}
    </nav>
    <div class="rt-header-actions">
      <LangSwitch lang={lang} path={path} />
      <Button variant="quiet" href={LINKS.login}>{T.actions.login}</Button>
      <Button variant="secondary" href={demo}>{T.actions.demo}</Button>
      <Button variant="primary" href={LINKS.signup}>{T.actions.trial}</Button>
    </div>
  </div>
  <details class="rt-menu">
    <summary><span class="rt-brand"><BrandMark />Reticora</span><span class="rt-menu-toggle">{T.menu}</span></summary>
    <nav class="rt-menu-body" aria-label={T.nav.menuLabel}>
      <a href={home}>{T.home}</a>
      {items.map((i) => <a href={i.href} aria-current={i.current ? 'page' : undefined}>{i.label}</a>)}
      <a href={LINKS.login}>{T.actions.login}</a>
      <div class="rt-row">
        <Button variant="primary" href={LINKS.signup}>{T.actions.trial}</Button>
        <Button variant="secondary" href={demo}>{T.actions.demo}</Button>
      </div>
      <LangSwitch lang={lang} path={path} />
    </nav>
  </details>
</header>
