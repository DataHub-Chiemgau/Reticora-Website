---
/** Formularfeld mit sichtbarer Beschriftung, optionalem Hilfetext und Fehlerplatz.
 *  Der Fehlerplatz (`#f-<name>-err`) ist leer und verborgen; die Insel `form` füllt und zeigt ihn und setzt `aria-invalid`. */
interface Option { value: string; text: string }
interface Props {
  name: string;
  label: string;
  kind?: 'input' | 'textarea' | 'select';
  type?: 'text' | 'email';
  hint?: string;
  required?: boolean;
  autocomplete?: string;
  options?: Option[];
  choose?: string;
  rows?: number;
}
const { name, label, kind = 'input', type = 'text', hint, required = false, autocomplete, options = [], choose, rows = 6 } = Astro.props;
const id = `f-${name}`;
const describedby = [hint ? `${id}-hint` : null, `${id}-err`].filter(Boolean).join(' ');
---

<div class="rt-field" data-field={name}>
  <label for={id}>{label}</label>
  {hint && <p class="rt-hint" id={`${id}-hint`}>{hint}</p>}
  {kind === 'textarea' && <textarea class="rt-input" id={id} name={name} rows={rows} required={required} autocomplete={autocomplete} aria-describedby={describedby}></textarea>}
  {kind === 'select' && (
    <select class="rt-input" id={id} name={name} required={required} autocomplete={autocomplete} aria-describedby={describedby}>
      <option value="">{choose}</option>
      {options.map((o) => <option value={o.value}>{o.text}</option>)}
    </select>
  )}
  {kind === 'input' && <input class="rt-input" id={id} name={name} type={type} required={required} autocomplete={autocomplete} aria-describedby={describedby} />}
  <p class="rt-error" id={`${id}-err`} hidden></p>
</div>
