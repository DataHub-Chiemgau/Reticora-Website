---
import Para from './Para.astro';
import type { ClaimId, Lang } from '../data/types';

interface Props { steps: { title: string; text: string; claim?: ClaimId }[]; lang: Lang }
const { steps, lang } = Astro.props;
---

<ol class="rt-steps">
  {steps.map((s) => (
    <li>
      <div>
        <h3>{s.title}</h3>
        <Para text={s.claim ? `${s.text} [${s.claim}]` : s.text} lang={lang} />
      </div>
    </li>
  ))}
</ol>
