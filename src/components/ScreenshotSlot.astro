---
import { screenshot } from '../data/screenshots';
import type { Lang, ScreenshotId } from '../data/types';
import { UI } from '../i18n/de';

interface Props { id: ScreenshotId; figure: number; caption: string; ratio?: '16x10' | '4x5'; lang: Lang }
const { id, figure, caption, ratio = '16x10', lang } = Astro.props;
const shot = screenshot(id);
const motif = shot.motif[lang];
const src = shot.file ? (shot.file.startsWith('/') ? shot.file : `/screenshots/${shot.file}`) : undefined;
---

<figure class="rt-figure">
  <div class:list={['rt-slot', ratio === '4x5' && 'rt-slot--4x5']}>
    {src ? <img src={src} alt={motif} width={shot.width} height={shot.height} loading="lazy" decoding="async" /> : (
      <div class="rt-slot-label" data-placeholder={id}>
        <b>{id}</b>
        <span>{motif}</span>
        <small>{UI.placeholder} · {shot.width} × {shot.height} · {UI.darkTheme}</small>
      </div>
    )}
  </div>
  <figcaption><b>{UI.figure} {figure} ·</b>{' '}{caption}</figcaption>
</figure>
