---
import Leitstand from '../layouts/Leitstand.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import StatusStrip from '../components/StatusStrip.astro';
import ScreenshotSlot from '../components/ScreenshotSlot.astro';
import SpecList from '../components/SpecList.astro';
import Beleg from '../components/Beleg.astro';
import Steps from '../components/Steps.astro';
import DataTable from '../components/DataTable.astro';
import CodeSample from '../components/CodeSample.astro';
import Notice from '../components/Notice.astro';
import TopologyStage from '../components/TopologyStage.astro';
import StatusTag from '../components/StatusTag.astro';
import { ui } from '../i18n';

const UI = ui('de');

const columns = [
  { key: 'source', head: 'Quelle' },
  { key: 'rank', head: 'Rang', numeric: true },
  { key: 'origin', head: 'Woher der Wert kommt' },
];
const rows = [
  { source: 'manuell / Override', rank: '100', origin: 'Wert, den ein Mensch gesetzt hat' },
  { source: 'Redfish', rank: '90', origin: 'Baseboard-Controller des Servers' },
  { source: 'SNMP', rank: '80', origin: 'Switches, Router, USVs, PDUs' },
];
const steps = [
  { title: 'Konto anlegen', text: 'Organisation, E-Mail-Adresse und Name genügen.' },
  { title: 'Collector verbinden', text: 'Sie installieren den Collector in Ihrem Netz und geben den Enrollment-Code ein.' },
  { title: 'Scopes bestätigen', text: 'Der Collector meldet seine Netze. Sie entscheiden, welche durchsucht werden.' },
];
---

<!-- path: erprobt aria-current der Navigation; die Seite ist noindex und nur ohne RETICORA_RELEASE=1 gebaut. -->
<Leitstand title="Bausteine – Entwicklung" description="Entwicklungsseite mit allen Bausteinen." lang="de" path="/produkt/discovery/" noindex>
  <div class="rt-container dev-intro">
    <h1 class="display-l">Bausteine</h1>
  </div>

  <Section id="aktionen" title="Knöpfe, Hinweise, Kennzeichen" lead="Eine Handlung je Knopf, ein Band je Abschnitt.">
    <div class="dev-stack">
      <div class="dev-row">
        <Button variant="primary" href="#aktionen">30 Tage testen</Button>
        <Button variant="secondary" href="#aktionen">Live-Demo</Button>
        <Button variant="quiet" href="#aktionen">Anmelden</Button>
        <Button variant="primary" type="button">Absenden</Button>
      </div>
      <div class="dev-row">
        <Button variant="primary" size="lg" href="#aktionen">30 Tage testen</Button>
        <Button variant="secondary" size="lg" href="#aktionen">Live-Demo</Button>
      </div>
      <Notice lead="Nur für Unternehmen.">Reticora richtet sich ausschließlich an Unternehmen. Alle Preise zzgl. MwSt.</Notice>
      <Notice variant="signal" lead="Über dem Limit:">Neue Geräte werden nicht verworfen. Sie warten als Review „nicht lizenziert“, bis Sie entscheiden.</Notice>
      <div class="dev-row">
        <StatusTag tone="ok">Aktiv</StatusTag>
        <StatusTag tone="signal">Wartung</StatusTag>
        <StatusTag tone="danger">Außer Betrieb</StatusTag>
        <StatusTag>Unbekannt</StatusTag>
      </div>
    </div>
  </Section>

  <Section id="daten" title="Betriebsleiste, Kennwerte, Beleg, Tabelle">
    <div class="dev-stack">
      <StatusStrip items={[
        { label: 'Sweep', value: 'alle 24 h' },
        { label: 'Poll', value: 'alle 15 min' },
        { label: 'Verbindung', value: 'nur ausgehend · 443, 4222' },
        { label: 'Hosting', value: 'EU' },
      ]} lang="de" />
      <div class="dev-narrow">
        <SpecList lang="de" items={[
          { term: 'Sweep', value: 'alle 24 h' },
          { term: 'Verbindung', value: 'nur ausgehend', claim: 'C-02' },
          { term: 'Puffer ohne Verbindung', value: 'bis 24 h' },
        ]} />
      </div>
      <div class="rt-para dev-measure" role="paragraph" id="beleg-absatz">Der Collector baut ausschließlich ausgehende Verbindungen auf. Die Datenhaltung liegt in der EU. <Beleg claim="C-07" lang="de" /></div>
      <DataTable label="Rangfolge der Quellen" columns={columns} rows={rows} rowHeader="source" lang="de" />
    </div>
  </Section>

  <Section id="inhalt-bausteine" title="Ablauf, Code, Abbildungen">
    <div class="dev-stack">
      <div class="dev-narrow"><Steps steps={steps} lang="de" /></div>
      <CodeSample title="GET /api/v1/cis" copyLabel={UI.copy} copiedLabel={UI.copied} lang="de"><span class="c"># Alle CIs, deren Name „core“ enthält</span>
curl <span class="k">"https://www.reticora.cloud/api/v1/cis?q=core&amp;limit=50"</span> \
  -H <span class="k">"X-API-Key: rk_live_…"</span></CodeSample>
      <TopologyStage lang="de" />
      <TopologyStage lang="en" />
      <div class="dev-figures">
        <ScreenshotSlot id="S-06" figure={2} caption="Der ausgefallene Switch und alle CIs, die von ihm abhängen." lang="de" />
        <ScreenshotSlot id="S-05" figure={3} caption="Belegung je Höheneinheit." ratio="4x5" lang="de" />
      </div>
    </div>
  </Section>

  <div data-theme="dokument" class="rt-theme-canvas dev-doc">
    <Section id="dokument" title="Thema Dokument">
      <div class="dev-stack">
        <div class="dev-row">
          <Button variant="primary" type="button">Absenden</Button>
          <Button variant="secondary" href="#dokument">Zur Startseite</Button>
          <Button variant="quiet" href="#dokument">Datenschutzerklärung</Button>
        </div>
        <Notice lead="Nur für Unternehmen.">Reticora richtet sich ausschließlich an Unternehmen.</Notice>
        <DataTable label="Rangfolge der Quellen im Thema Dokument" columns={columns} rows={rows} rowHeader="source" lang="de" />
        <div class="dev-row">
          <StatusTag tone="ok">Aktiv</StatusTag>
          <StatusTag tone="danger">Außer Betrieb</StatusTag>
        </div>
      </div>
    </Section>
  </div>
</Leitstand>

<style>
  .dev-intro { padding-top: var(--space-12); }
  .dev-stack { display: flex; flex-direction: column; gap: var(--space-6); }
  .dev-row { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); }
  .dev-narrow { max-width: 420px; }
  .dev-measure { max-width: var(--measure); }
  .dev-figures { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: var(--space-6); align-items: start; }
  @media (max-width: 47.99rem) { .dev-figures { grid-template-columns: minmax(0, 1fr); } }
</style>
