Options -Indexes
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html
RewriteEngine On
# Nichts unter /backend/ und keine Dateien oder Ordner mit führendem Punkt (außer .well-known) ausliefern.
RewriteRule ^backend(/|$) - [F,L]
RewriteRule (^|/)\.(?!well-known(/|$)) - [F,L]
# Produktionshost: http und ohne www in einem Schritt auf https://www
RewriteCond %{HTTP_HOST} ^(www\.)?reticora\.de$ [NC]
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.reticora.de%{REQUEST_URI} [R=301,L]
# index.html nie in der Adresse
# (%1 statt $1: gilt auch in Unterordnern mit eigener .htaccess und RewriteOptions Inherit)
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule (^|/)index\.html$ /%1 [R=301,L]
Header always set Strict-Transport-Security "max-age=31536000"
Header always set Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; base-uri 'none'; frame-ancestors 'none'"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Cross-Origin-Opener-Policy "same-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
<FilesMatch "\.html$">
  Header always set Cache-Control "no-cache"
</FilesMatch>
# nur bei Erfolg: ein fehlendes Hash-Asset (404) darf nicht ein Jahr lang gecacht werden
<If "%{REQUEST_URI} =~ m#^/_astro/#">
  Header always set Cache-Control "public, max-age=31536000, immutable" "expr=%{REQUEST_STATUS} -lt 400"
</If>
AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml
