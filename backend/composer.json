{
    "name": "reticora/website-backend",
    "description": "Lead-Backend der Reticora-Website (reines PHP; Composer nur für Entwicklung)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": { "Reticora\\Lead\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Reticora\\Lead\\Tests\\": "tests/" }
    },
    "config": { "sort-packages": true, "platform": { "php": "8.2.0" } }
}
