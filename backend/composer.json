{
    "name": "reticora/website-backend",
    "description": "Lead-Backend der Reticora-Website (PHP; zur Laufzeit nur PHPMailer)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "phpmailer/phpmailer": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Reticora\\Lead\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Reticora\\Lead\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        }
    }
}
