{
  "name": "reticora-website",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "tokens": "node scripts/build-tokens.mjs",
    "build": "npm run tokens && astro build",
    "check": "astro check",
    "test": "vitest run",
    "serve": "bash tests/server/start.sh",
    "test:e2e": "playwright test",
    "build:release": "RETICORA_RELEASE=1 npm run build && node scripts/check-release.mjs",
    "validate": "html-validate \"dist/**/*.html\"",
    "lhci": "lhci autorun"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.16.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "22.20.5",
    "astro": "7.4.11",
    "html-validate": "11.21.0",
    "tailwindcss": "4.3.5",
    "typescript": "^6",
    "vitest": "5.1.0"
  }
}
